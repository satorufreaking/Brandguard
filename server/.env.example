# BrandGuard AI Server Environment Variables
PORT=5000

# Optional for local development. Production always requires MongoDB.
# Set REQUIRE_MONGODB=true to disable embedded storage and fail startup if Atlas
# is missing or unreachable. Render sets this automatically in render.yaml.
# Local development may use server/data/brandguard_store.json when MongoDB is unset.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/brandguard?retryWrites=true&w=majority
MONGODB_URI=
REQUIRE_MONGODB=false

# Optional exact browser origins when the frontend is hosted separately.
# Local Vite origins are already allowed.
# CORS_ORIGINS=https://your-frontend.example

# Optional: LLM Provider API Keys (for semantic review checks)
# Keep these keys on the server; never use VITE_ prefixes for secrets.
# LLM_PROVIDER=deterministic
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
